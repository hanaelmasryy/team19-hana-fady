{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectAsOwnDatabaseUserOnly",
      "Effect": "Allow",
      "Action": "rds-db:connect",
      "Resource": "arn:aws:rds-db:${REGION}:${ACCOUNT_ID}:dbuser:${DBI_RESOURCE_ID}/dashboard_ro"
    },
    {
      "Sid": "NoInstanceManagement",
      "Effect": "Deny",
      "Action": ["rds:Delete*", "rds:Modify*", "rds:Create*", "rds:Reboot*", "rds:Stop*", "rds:Restore*"],
      "Resource": "*"
    },
    {
      "Sid": "NoPrivilegeEscalation",
      "Effect": "Deny",
      "Action": ["iam:*", "sts:AssumeRole"],
      "Resource": "*"
    }
  ]
}
