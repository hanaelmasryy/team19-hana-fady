# Copy this file to .env and fill in real values. Never commit .env.
# In the cloud, the same names are set in the Vercel project's
# Environment Variables settings.

# Neon connection strings, one per database role (see db/roles.sql).
# Use the pooled connection string from the Neon dashboard and keep ?sslmode=require
DATABASE_URL=postgresql://app_rw:PASSWORD@HOST/neondb?sslmode=require
DASHBOARD_DATABASE_URL=postgresql://dashboard_ro:PASSWORD@HOST/neondb?sslmode=require
NOTIFIER_DATABASE_URL=postgresql://notifier:PASSWORD@HOST/neondb?sslmode=require

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5500

# Daily job secret (Vercel sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Email channel (Brevo). Set EMAIL_ENABLED=false to use in-app notifications only.
EMAIL_ENABLED=false
EMAIL_API_KEY=
EMAIL_SENDER=

# Local development only
PORT=3000

# Used only by "npm run seed" to create the first demo accounts
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
