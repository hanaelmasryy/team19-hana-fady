digraph ER {
  graph [rankdir=LR, splines=spline, nodesep=0.35, ranksep=0.9, pad=0.3, bgcolor="white",
         fontname="Helvetica", label=<<B>Team 19 – Customer Onboarding Checklist Portal: database (backend/db/schema.sql)</B><BR/><FONT POINT-SIZE="11">PK primary key · FK foreign key · UQ unique · one-to-many lines: bar = exactly one, circle = optional, crow's foot = many</FONT>>,
         labelloc=t, fontsize=16];
  node  [shape=plain, fontname="Helvetica", fontsize=11];
  edge  [fontname="Helvetica", fontsize=9, color="#4A5A73", fontcolor="#4A5A73", dir=both, arrowsize=0.9, penwidth=1.2];

  users [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2F5496">
    <TR><TD BGCOLOR="#2F5496" COLSPAN="3"><FONT COLOR="white"><B>users</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">serial</TD><TD PORT="id">PK</TD></TR>
    <TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">text, lower-case</TD><TD>UQ</TD></TR>
    <TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">text (bcrypt)</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">Admin | Staff | Customer</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">boolean</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">created_at, updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
  </TABLE>>];

  login_attempts [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#7F7F7F">
    <TR><TD BGCOLOR="#7F7F7F" COLSPAN="3"><FONT COLOR="white"><B>login_attempts</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>email</B></TD><TD ALIGN="LEFT">text</TD><TD>PK</TD></TR>
    <TR><TD ALIGN="LEFT"><B>ip_address</B></TD><TD ALIGN="LEFT">text</TD><TD>PK</TD></TR>
    <TR><TD ALIGN="LEFT">failed_count</TD><TD ALIGN="LEFT">integer ≥ 0</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">last_failed_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">locked_until</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
    <TR><TD COLSPAN="3" ALIGN="LEFT"><I><FONT POINT-SIZE="9">no FK: also counts unknown emails (lockout)</FONT></I></TD></TR>
  </TABLE>>];

  templates [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2E7D32">
    <TR><TD BGCOLOR="#2E7D32" COLSPAN="3"><FONT COLOR="white"><B>templates</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">serial</TD><TD PORT="id">PK</TD></TR>
    <TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">active | archived</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">integer ≥ 1</TD><TD></TD></TR>
    <TR><TD PORT="created_by" ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT">→ users.id</TD><TD>FK</TD></TR>
    <TR><TD ALIGN="LEFT">created_at, updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
  </TABLE>>];

  template_tasks [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#2E7D32">
    <TR><TD BGCOLOR="#2E7D32" COLSPAN="3"><FONT COLOR="white"><B>template_tasks</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">serial</TD><TD PORT="id">PK</TD></TR>
    <TR><TD PORT="template_id" ALIGN="LEFT">template_id</TD><TD ALIGN="LEFT">→ templates.id (cascade)</TD><TD>FK</TD></TR>
    <TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">position</TD><TD ALIGN="LEFT">integer ≥ 1</TD><TD>UQ*</TD></TR>
    <TR><TD ALIGN="LEFT">offset_days</TD><TD ALIGN="LEFT">0 – 365</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">visibility</TD><TD ALIGN="LEFT">internal | customer</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">actor</TD><TD ALIGN="LEFT">staff | customer</TD><TD></TD></TR>
    <TR><TD COLSPAN="3" ALIGN="LEFT"><I><FONT POINT-SIZE="9">* UQ (template_id, position)</FONT></I></TD></TR>
  </TABLE>>];

  onboarding_plans [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#B26A00">
    <TR><TD BGCOLOR="#B26A00" COLSPAN="3"><FONT COLOR="white"><B>onboarding_plans</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">serial</TD><TD PORT="id">PK</TD></TR>
    <TR><TD PORT="template_id" ALIGN="LEFT">template_id</TD><TD ALIGN="LEFT">→ templates.id</TD><TD>FK</TD></TR>
    <TR><TD ALIGN="LEFT">template_version</TD><TD ALIGN="LEFT">integer (snapshot)</TD><TD></TD></TR>
    <TR><TD PORT="customer_id" ALIGN="LEFT">customer_id</TD><TD ALIGN="LEFT">→ users.id</TD><TD>FK</TD></TR>
    <TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">start_date</TD><TD ALIGN="LEFT">date</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">Active | Completed | Cancelled</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">cancel_reason</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
    <TR><TD PORT="created_by" ALIGN="LEFT">created_by</TD><TD ALIGN="LEFT">→ users.id</TD><TD>FK</TD></TR>
    <TR><TD ALIGN="LEFT">created_at, updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
  </TABLE>>];

  tasks [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#B26A00">
    <TR><TD BGCOLOR="#B26A00" COLSPAN="3"><FONT COLOR="white"><B>tasks</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">serial</TD><TD PORT="id">PK</TD></TR>
    <TR><TD PORT="plan_id" ALIGN="LEFT">plan_id</TD><TD ALIGN="LEFT">→ onboarding_plans.id (cascade)</TD><TD>FK</TD></TR>
    <TR><TD PORT="template_task_id" ALIGN="LEFT">template_task_id</TD><TD ALIGN="LEFT">→ template_tasks.id (set null)</TD><TD>FK</TD></TR>
    <TR><TD ALIGN="LEFT">title, position</TD><TD ALIGN="LEFT">copied from the template</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">visibility, actor</TD><TD ALIGN="LEFT">copied from the template</TD><TD></TD></TR>
    <TR><TD PORT="assignee_id" ALIGN="LEFT">assignee_id</TD><TD ALIGN="LEFT">→ users.id</TD><TD>FK</TD></TR>
    <TR><TD ALIGN="LEFT">due_date</TD><TD ALIGN="LEFT">date</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">Not Started | In Progress | Done</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">completed_at, updated_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
  </TABLE>>];

  internal_notes [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#6A1B9A">
    <TR><TD BGCOLOR="#6A1B9A" COLSPAN="3"><FONT COLOR="white"><B>internal_notes</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">serial</TD><TD>PK</TD></TR>
    <TR><TD PORT="plan_id" ALIGN="LEFT">plan_id</TD><TD ALIGN="LEFT">→ onboarding_plans.id (cascade)</TD><TD>FK</TD></TR>
    <TR><TD PORT="task_id" ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT">→ tasks.id, optional (cascade)</TD><TD>FK</TD></TR>
    <TR><TD PORT="author_id" ALIGN="LEFT">author_id</TD><TD ALIGN="LEFT">→ users.id</TD><TD>FK</TD></TR>
    <TR><TD ALIGN="LEFT">body</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
  </TABLE>>];

  notifications [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#6A1B9A">
    <TR><TD BGCOLOR="#6A1B9A" COLSPAN="3"><FONT COLOR="white"><B>notifications</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">serial</TD><TD>PK</TD></TR>
    <TR><TD PORT="user_id" ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">→ users.id</TD><TD>FK</TD></TR>
    <TR><TD PORT="plan_id" ALIGN="LEFT">plan_id</TD><TD ALIGN="LEFT">→ onboarding_plans.id (cascade)</TD><TD>FK</TD></TR>
    <TR><TD PORT="task_id" ALIGN="LEFT">task_id</TD><TD ALIGN="LEFT">→ tasks.id, optional (cascade)</TD><TD>FK</TD></TR>
    <TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">assigned | overdue | at_risk</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">channel</TD><TD ALIGN="LEFT">in_app | email</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">delivery_status</TD><TD ALIGN="LEFT">sent | failed | skipped</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">notify_date</TD><TD ALIGN="LEFT">date</TD><TD>UQ*</TD></TR>
    <TR><TD ALIGN="LEFT">read_at, created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
    <TR><TD COLSPAN="3" ALIGN="LEFT"><I><FONT POINT-SIZE="9">* once per day per user, plan, task, type, channel</FONT></I></TD></TR>
  </TABLE>>];

  audit_log [label=<
  <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#C62828">
    <TR><TD BGCOLOR="#C62828" COLSPAN="3"><FONT COLOR="white"><B>audit_log</B> (insert-only)</FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigserial</TD><TD>PK</TD></TR>
    <TR><TD PORT="actor_id" ALIGN="LEFT">actor_id</TD><TD ALIGN="LEFT">→ users.id, optional</TD><TD>FK</TD></TR>
    <TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">entity, entity_id</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">result</TD><TD ALIGN="LEFT">allowed | denied</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">ip_address</TD><TD ALIGN="LEFT">text</TD><TD></TD></TR>
    <TR><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD></TD></TR>
  </TABLE>>];

  // parent:id -> child:fk  (tail = parent side, head = child side)
  users:id:e -> templates:created_by:w              [arrowtail=teeodot, arrowhead=crowodot, label="creates"];
  templates:id:e -> template_tasks:template_id:w    [arrowtail=teetee,  arrowhead=crowtee,  label="1–100 task rules"];
  templates:id:e -> onboarding_plans:template_id:w  [arrowtail=teetee,  arrowhead=crowodot, label="used for"];
  users:id:e -> onboarding_plans:customer_id:w      [arrowtail=teetee,  arrowhead=crowodot, label="customer of"];
  users:id:e -> onboarding_plans:created_by:w       [arrowtail=teeodot, arrowhead=crowodot, label="creates", style=dashed];
  onboarding_plans:id:e -> tasks:plan_id:w          [arrowtail=teetee,  arrowhead=crowtee,  label="contains (copied)"];
  template_tasks:id:e -> tasks:template_task_id:w   [arrowtail=teeodot, arrowhead=crowodot, label="copied from", style=dashed];
  users:id:e -> tasks:assignee_id:w                 [arrowtail=teeodot, arrowhead=crowodot, label="owns"];
  onboarding_plans:id:e -> internal_notes:plan_id:w [arrowtail=teetee,  arrowhead=crowodot, label="staff-only notes"];
  tasks:id:e -> internal_notes:task_id:w            [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  users:id:e -> internal_notes:author_id:w          [arrowtail=teetee,  arrowhead=crowodot, label="writes", style=dashed];
  users:id:e -> notifications:user_id:w             [arrowtail=teetee,  arrowhead=crowodot, label="receives"];
  onboarding_plans:id:e -> notifications:plan_id:w  [arrowtail=teetee,  arrowhead=crowodot, style=dashed];
  tasks:id:e -> notifications:task_id:w             [arrowtail=teeodot, arrowhead=crowodot, style=dashed];
  users:id:e -> audit_log:actor_id:w                [arrowtail=teeodot, arrowhead=crowodot, label="actor of"];

  { rank=same; templates; audit_log; }
  { rank=same; template_tasks; onboarding_plans; }
  { rank=same; internal_notes; notifications; }
  { rank=same; users; login_attempts; }
}
